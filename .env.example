# Server Port
PORT=4201

# Environment
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
URLDB=mongodb+srv://<username>:<password>@cluster0.mongodb.net/praacofi?retryWrites=true&w=majority

# JWT Authentication
SEED_AUTENTICACION=your_secure_jwt_secret_key_here
CADUCIDAD_TOKEN=48h

# CORS (use * for all or comma-separated origins: http://localhost:3000,https://myfrontend.vercel.app)
CORS_ORIGIN=*
